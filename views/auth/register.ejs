<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Crear cuenta — KaisutNews</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/styles.css">
</head>
<body style="min-height:100vh;display:flex;flex-direction:column;">

  <%- include('../nav.ejs') %>

  <main style="flex:1;display:flex;align-items:center;justify-content:center;padding:3rem 1.5rem;">
    <div style="width:100%;max-width:400px;">

      <div style="margin-bottom:1.75rem;" class="fade-in fade-in-1">
        <div class="section-eyebrow">Registro</div>
        <h1 style="font-size:1.5rem;font-weight:800;letter-spacing:-0.035em;color:var(--text-1);margin:0.35rem 0 0;">
          Crear cuenta
        </h1>
      </div>

      <div style="height:1px;background:var(--border);margin-bottom:1.75rem;"></div>

      <% if (error) { %>
        <div style="border:1px solid var(--border);border-radius:var(--radius-md);padding:0.65rem 0.9rem;margin-bottom:1.25rem;font-size:0.8125rem;color:var(--text-4);display:flex;align-items:center;gap:0.5rem;" class="fade-in fade-in-1">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" style="flex-shrink:0;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <%= error %>
        </div>
      <% } %>

      <form method="POST" action="/register" style="display:flex;flex-direction:column;gap:1.1rem;" class="fade-in fade-in-2">

        <div class="form-group">
          <label for="username" class="form-label">Usuario</label>
          <input type="text" id="username" name="username" required class="form-input" placeholder="Elige un nombre de usuario" autocomplete="username" />
        </div>

        <div class="form-group">
          <label for="password" class="form-label">Contraseña</label>
          <input type="password" id="password" name="password" required class="form-input" placeholder="Mínimo 6 caracteres" autocomplete="new-password" />
        </div>

        <!-- Avatar -->
        <div class="form-group">
          <span class="form-label">Avatar</span>
          <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:0.6rem;margin-top:0.2rem;" id="avatar-grid">
            <% for(let i = 1; i <= 4; i++) { %>
              <label style="display:flex;align-items:center;justify-content:center;cursor:pointer;">
                <input type="radio" name="avatar" value="avatar<%= i %>.webp" style="display:none;" id="av<%= i %>" <%= i === 1 ? 'checked' : '' %> />
                <img
                  src="/avatars/avatar<%= i %>.webp"
                  alt="Avatar <%= i %>"
                  id="img-av<%= i %>"
                  onclick="selectAv(this,'av<%= i %>')"
                  style="width:52px;height:52px;border-radius:50%;object-fit:cover;cursor:pointer;border:1px solid var(--border);transition:border-color 0.15s;box-sizing:border-box;"
                />
              </label>
            <% } %>
          </div>
        </div>

        <button type="submit" class="btn-primary" style="justify-content:center;padding:0.6rem;margin-top:0.25rem;">
          Crear cuenta
        </button>
      </form>

      <p style="margin-top:1.5rem;font-size:0.8rem;color:var(--text-5);text-align:center;" class="fade-in fade-in-3">
        ¿Ya tienes cuenta?
        <a href="/login" style="color:var(--text-4);font-weight:500;text-decoration:none;margin-left:3px;">Inicia sesión</a>
      </p>
    </div>
  </main>

  <script>
    function selectAv(img, radioId) {
      document.querySelectorAll('[id^="img-av"]').forEach(i => {
        i.style.border = '1px solid var(--border)';
        i.style.opacity = '0.5';
      });
      img.style.border = '1px solid var(--text-4)';
      img.style.opacity = '1';
      document.getElementById(radioId).checked = true;
    }
    document.addEventListener('DOMContentLoaded', () => {
      const first = document.getElementById('img-av1');
      if (first) selectAv(first, 'av1');
    });
  </script>

  <%- include('../footer.ejs') %>
</body>
</html>