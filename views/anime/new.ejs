<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= isPending ? 'Proponer noticia' : 'Nueva noticia' %> — KaisutNews</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

  <%- include('../nav.ejs') %>

  <main class="page-wrapper" style="padding-top:3rem;padding-bottom:5rem;">
    <div style="max-width:560px;margin:0 auto;">

      <div style="margin-bottom:2rem;" class="fade-in fade-in-1">
        <div class="section-eyebrow"><%= isPending ? 'Propuesta de comunidad' : 'Administración' %></div>
        <h1 style="font-size:1.5rem;font-weight:800;letter-spacing:-0.035em;color:var(--text-1);margin:0.35rem 0 0;">
          <%= isPending ? 'Proponer una noticia' : 'Nueva noticia' %>
        </h1>
        <% if (isPending) { %>
          <p style="font-size:0.8125rem;color:var(--text-5);margin-top:0.4rem;">Será revisada por un administrador antes de publicarse.</p>
        <% } %>
      </div>

      <div style="height:1px;background:var(--border);margin-bottom:2rem;"></div>

      <form action="<%= isPending ? '/submit' : '/new' %>" method="POST" style="display:flex;flex-direction:column;gap:1.25rem;" class="fade-in fade-in-2">

        <div class="form-group">
          <label for="title" class="form-label">Título</label>
          <input type="text" id="title" name="title" required class="form-input" placeholder="Escribe el título…" />
        </div>

        <div class="form-group">
          <label for="content" class="form-label">Contenido</label>
          <textarea id="content" name="content" rows="7" required class="form-textarea" placeholder="Escribe el contenido de la noticia…"></textarea>
        </div>

        <div class="form-group">
          <label for="image" class="form-label">
            URL de imagen
            <span style="text-transform:none;letter-spacing:0;font-weight:400;color:var(--text-5);"> — opcional</span>
          </label>
          <input type="text" id="image" name="image" class="form-input" placeholder="https://…" />
        </div>

        <div style="display:flex;gap:0.6rem;padding-top:0.5rem;">
          <button type="submit" class="btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            <%= isPending ? 'Enviar para revisión' : 'Publicar' %>
          </button>
          <a href="/" class="btn-ghost">Cancelar</a>
        </div>

      </form>
    </div>
  </main>

  <%- include('../footer.ejs') %>
</body>
</html>